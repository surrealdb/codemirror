	diskann					[@name=Keyword],
	dist					[@name=Keyword],
	distance				[@name=Keyword],
	distinct				[@name=Keyword],
	doc_ids_cache			[@name=Keyword],
	doc_ids_order			[@name=Keyword],
	doc_lengths_cache		[@name=Keyword],
	doc_lengths_order		[@name=Keyword],
	drop					[@name=Keyword],
	duplicate				[@name=Keyword],
	duration				[@name=Keyword],
	edges					[@name=Keyword],
	efc						[@name=Keyword],
	else					[@name=Keyword],
	end						[@name=Keyword],
	enforced				[@name=Keyword],
	event					[@name=Keyword],
	exclude					[@name=Keyword],
	existing				[@name=Keyword],
	exists					[@name=Keyword],
	expired					[@name=Keyword],
	explain					[@name=Keyword],
	expunge					[@name=Keyword],
	extend_candidates		[@name=Keyword],
	extension				[@name=Keyword],
	fallback				[@name=Keyword],
	fetch					[@name=Keyword],
	field					[@name=Keyword],
	fields					[@name=Keyword],
	filters					[@name=Keyword],
	flexible				[@name=Keyword],
	for						[@name=Keyword],
	format					[@name=Keyword],
	from					[@name=Keyword],
	fulltext				[@name=Keyword],
	functions				[@name=Keyword],
	get						[@name=Keyword],
	grant					[@name=Keyword],
	graphql					[@name=Keyword],
	graphql_alias			[@name=Keyword],
