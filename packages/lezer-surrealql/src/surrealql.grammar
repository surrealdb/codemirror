@top SurrealQL {
	expressions
}

@top PermissionInput {
	WhereClause | none | full
}

@top IndexInput {
	IndexClause
}

@top CombinedResults {
	CombinedResult { CommentResult expression CommentResultClose { "" } }+
}

@top Syntax {
	(
		(for !for (create | update | delete | select)) |
		anyKeyword |
		anyLiteral |
		SyntaxDescribe { "@" rawident }
		| "|" | "[" | "]"
	)*
}

@precedence {
	prefix
	ifElse
	range @left
	method
	binary @left
	union @left
	filter
	for
	clause
	flexibleAfter
	closure
}

expressions {
	(expression ";")* expression ";"?
}

expression {
	statement |
	value
}

paramDefinition[@name=ParamDefinition] {
	VariableName
	(":" Type { type })?
}

escapedParamDefinition[@name=ParamDefinition] {
	VariableName
	(":" Type { safeType })?
}

anyKeyword {
	access |
	add |
	algorithm |
	alpha |
	alter |
	analyze |
	analyzer |
	any |
	as |
	asc |
	ascending |
	assert |
	async |
	at |
	audience |
	authenticate |
	auto |
	batch |
	bearer |
	begin |
	bm25 |
	break |
	by |
	cancel |
	capabilities |
	capacity |
	changefeed |
	changes |
	columns |
	comment |
	commit |
	compact |
	compatibility |
	complexity |
	concurrently |
	config |
	content |
	context |
	continue |
	create |
	database |
	db |
	default |
	defer |
	define |
	definer |
	degree |
	delete |
	depth |
	desc |
	descending |
	digest |
	bindings |
	constraint |
	dimension |
	diskann |
	dist |
	distance |
	distinct |
	doc_ids_cache |
	doc_ids_order |
	doc_lengths_cache |
	doc_lengths_order |
	drop |
	duplicate |
	duration |
	edges |
	efc |
	else |
	end |
	event |
	exclude |
	existing |
	exists |
	expired |
	explain |
	extend_candidates |
	extension |
	fallback |
	fetch |
	field |
	fields |
	filters |
	flexible |
	for |
	format |
	from |
	fulltext |
	functions |
	grant |
	graphql |
	graphql_alias |
	graphql_deprecated |
	group |
	hashed_vector |
	highlights |
	hnsw |
	if |
	ignore |
	in |
	include |
	index |
	info |
	inline |
	insert |
	into |
	introspection |
	invoker |
	isolation |
	issuer |
	jwt |
	keep_pruned_connections |
	key |
	kill |
	kv |
	l_build |
	let |
	level |
	lightweight |
	limit |
	live |
	lm |
	m |
	m0 |
	materialize |
	max |
	maxdepth |
	merge |
	migrate |
	module |
	mtree |
	mtree_cache |
	namespace |
	no |
	noindex |
	normal |
	not |
	ns |
	nulls |
	on |
	only |
	option |
	order |
	original |
	out |
	overwrite |
	parallel |
	param |
	passhash |
	passscram |
	password |
	patch |
	permissions |
	postings_cache |
	postings_order |
	prepare |
	purge |
	query_timeout |
	read |
	readonly |
	rebuild |
	record |
	references |
	refresh |
	relate |
	relation |
	remove |
	rename |
	retry |
	return |
	revoke |
	revoked |
	roles |
	root |
	rows |
	sc |
	schemaful |
	schemafull |
	schemaless |
	scope |
	search |
	security |
	select |
	sequence |
	session |
	set |
	show |
	signatures |
	signer |
	signin |
	signup |
	since |
	sleep |
	spatial |
	split |
	sql |
	staleness |
	start |
	structure |
	system |
	table |
	tables |
	tb |
	tempfiles |
	terms_cache |
	terms_order |
	then |
	throw |
	timeout |
	to |
	token |
	tokenizers |
	transaction |
	typeKeyword |
	undeclared |
	unique |
	unset |
	unsigned |
	update |
	upsert |
	url |
	use |
	user |
	using |
	valueKeyword |
	values |
	when |
	where |
	with
}

anyLiteral {
	after |
	before |
	diff |
	false |
	full |
	none |
	null |
	true |

	IndexTypeClause
}

SubQuery {
	"("
	expression
	")"
}

Block {
	"{" expressions? "}"
}

Closure[since=2_0_0] {
	"|" commaSep<escapedParamDefinition>? "|" (("->" type Block) | value !closure)
}

MockRecord[since=4_0_0] {
	"|" RecordId "|"
}

subqueryStatement {
	LetStatement |
	DeleteStatement |
	CreateStatement |
	SelectStatement |
	RelateStatement |
	UpdateStatement |
	RemoveStatement |
	UpsertStatement |
	ReturnStatement |
	AlterStatement |
	DefineStatement |
	RebuildStatement |
	InsertStatement |
	InfoForStatement |
	ExplainStatement
}

statement[@isGroup=Statement] {
	AccessStatement |
	BeginStatement |
	CancelStatement |
	CommitStatement |
	KillStatement |
	LiveSelectStatement |
	ShowStatement |
	SleepStatement |
	UseStatement |
	OptionStatement |
	BreakStatement |
	ContinueStatement |
	ForStatement |
	subqueryStatement
}

// Transaction statements

BeginStatement {
	begin transaction?
	(
		ReadOnlyClause[since=4_0_0] {
			read only
			( max staleness ( Duration | VariableName ) strict? )?
		} |
		IsolationClause[since=4_0_0] { isolation level Ident }
	)*
}
CancelStatement { cancel transaction? }
CommitStatement { commit transaction? }

// Access statement

AccessStatement[since=4_0_0] {
	access
	Ident
	OnRootNsDbClause?
	(
		grant for ( user Ident | record value ) |
		( show | revoke ) ( all | grant Ident | WhereClause ) |
		purge ( expired | revoked ) ( ","? ( expired | revoked ) )? ( for Duration )?
	)
}

// Explain statement

ExplainStatement[since=4_0_0] {
	explain
	analyze?
	( format Ident )?
	expression
}

// Define statements

DefineStatement {
	define
	(
		AccessDefinition[since=2_0_0] { access defineAccessOptions } |
		( namespace defineNamespaceOptions ) |
		( database defineDatabaseOptions ) |
		( user defineUserOptions ) |
		TokenDefinition[until=4_0_0] { token defineTokenOptions } |
		( event defineEventOptions ) |
		( field defineFieldOptions ) |
		( index defineIndexOptions ) |
		( analyzer defineAnalyzerOptions ) |
		( functionKw defineFunctionOptions ) |
		( param defineParamOptions ) |
		ScopeDefinition[until=2_0_0] { scope defineScopeOptions } |
		( table defineTableOptions ) |
		( config defineConfigOptions ) |
		( api defineApiOptions ) |
		( bucket defineBucketOptions ) |
		SequenceDefinition[since=4_0_0] { sequence defineSequenceOptions } |
		ExtensionDefinition[since=4_0_0] { ( extension | module ) defineExtensionOptions } |
		TypeDefinition[since=4_0_0] { typeKeyword defineTypeOptions }
	)
}

defineSequenceOptions {
	(IfNotExistsClause | OverwriteClause)?
	value
	(
		BatchClause { batch value } |
		StartClause |
		TimeoutClause
	)*
}

defineExtensionOptions {
	(IfNotExistsClause | OverwriteClause)?
	ExtensionName
	( from | as )
	ExtensionSource
	(
		unsigned |
		SignerClause { signer value } |
		DigestClause { digest String } |
		BindingsClause { bindings value } |
		CapabilitiesClause { capabilities value } |
		PermissionsBasicClause |
		CommentClause
	)*
}

ExtensionName {
	FunctionName Version?
}

ExtensionSource {
	ExtensionName |
	prefixedString
}

defineTypeOptions {
	(IfNotExistsClause | OverwriteClause)?
	Ident
	as
	type
	(
		AssertClause |
		ConstraintClause { constraint Ident assert value } |
		DefaultClause |
		SqlTypeClause |
		PermissionsBasicClause |
		CommentClause
	)*
}

defineAccessOptions {
	(IfNotExistsClause | OverwriteClause)?
	value
	OnRootNsDbClause
	(
		AccessTypeClause |
		AuthenticateClause |
		ContextClause |
		DurationClause |
		CommentClause
	)*
}

defineAnalyzerOptions {
	(IfNotExistsClause | OverwriteClause)?
	value
	(
		TokenizersClause |
		FiltersClause |
		FunctionClause |
		CommentClause
	)*
}

defineEventOptions {
	(IfNotExistsClause | OverwriteClause)?
	value
	OnTableClause
	(
		WhenClause |
		ThenClause |
		AsyncClause |
		RetryClause |
		MaxdepthClause |
		CommentClause
	)*
}

WhenClause {
	when
	value
}

ThenClause {
	then
	commaSep<value>
}

AsyncClause { async }
RetryClause[since=4_0_0] { retry Number }
MaxdepthClause[since=4_0_0] { maxdepth Number }

defineDatabaseOptions {
	(IfNotExistsClause | OverwriteClause)?
	value
	(
		strict |
		ChangefeedClause |
		CompatibilityClause |
		CommentClause
	)*
}

CompatibilityClause[since=4_0_0] {
	compatibility
	Number
}

defineFieldOptions {
	(IfNotExistsClause | OverwriteClause)?
	( Idiom | VariableName )
	OnTableClause
	(
		TypeClause |
		DefaultClause |
		ReadonlyClause |
		ValueClause |
		AssertClause |
		PermissionsForClause |
		CommentClause |
		ReferenceClause |
		ComputedClause |
		inline |
		MaterializeClause |
		MigrateClause |
		SqlTypeClause |
		GraphqlClause
	)*
}

defineFunctionOptions {
	(IfNotExistsClause | OverwriteClause)?
	customFunctionName
	params
	("->" type)?
	Block
	(
		PermissionsBasicClause |
		CommentClause |
		GraphqlClause
	)*
}

params { "(" commaSepTrailing<paramDefinition>? ")" }

functionKw[@name=Keyword] { function }

defineIndexOptions {
	(IfNotExistsClause | OverwriteClause)?
	value
	OnTableClause
	(
		FieldsColumnsClause |
		IndexClause |
		CommentClause |
		ConcurrentlyClause[since=2_0_0] { concurrently } |
		DeferClause[since=3_0_0,until=4_0_0] { defer }
	)*
}

defineNamespaceOptions {
	(IfNotExistsClause | OverwriteClause)?
	value
	CommentClause*
}

defineParamOptions {
	(IfNotExistsClause | OverwriteClause)?
	VariableName
	(
		( valueKeyword value ) |
		PermissionsBasicClause |
		CommentClause
	)*
}

defineScopeOptions {
	(IfNotExistsClause | OverwriteClause)?
	value
	(
		SessionClause |
		SigninClause |
		SignupClause |
		CommentClause
	)*
}

defineTableOptions {
	(IfNotExistsClause | OverwriteClause)?
	value
	(
		drop |
		(schemafull | schemaful | schemaless) |
		TableTypeClause |
		TableViewClause |
		ChangefeedClause |
		PermissionsForClause |
		CommentClause |
		InlineClause |
		GraphqlClause
	)*
}

defineConfigOptions {
	(IfNotExistsClause | OverwriteClause)?
	configTarget
}

configTarget {
	graphql defineConfigGraphqlOptions |
	api defineConfigApiOptions |
	ConfigDefaultClause[since=4_0_0] {
		default
		( ( namespace | ns | database | db ) value )+
	}
}

defineConfigGraphqlOptions {
	(
		none |
		auto |
		tables ( none | auto | include commaSep<Ident> | exclude commaSep<Ident> ) |
		functions ( none | auto | include commaSep<customFunctionName> | exclude commaSep<customFunctionName> ) |
		( depth | complexity ) Number |
		introspection ( none | auto )
	)*
}

defineConfigApiOptions {
	ApiOptions
}

defineTokenOptions {
	(IfNotExistsClause | OverwriteClause)?
	value
	( on ( namespace | database | scope value ) )
	TokenTypeClause
	( valueKeyword String )
}

defineUserOptions {
	(IfNotExistsClause | OverwriteClause)?
	value
	OnRootNsDbClause
	(
		( ( password | passhash | passscram ) String ) |
		( roles commaSep<Ident> ) |
		DurationClause |
		CommentClause
	)*
}

defineApiOptions {
	(IfNotExistsClause | OverwriteClause)?
	value
	ApiOptions
	(
		ApiMethodClause |
		SecurityClause |
		CommentClause
	)*
}

ApiMethodClause {
	for
	(any | commaSep<HttpMethod>)
	ApiOptions
	( then value )?
}

SecurityClause[since=4_0_0] {
	security
	( definer | invoker )
}

ApiOptions {
	(
		PermissionsBasicClause |
		MiddlewareClause
	)*
}

HttpMethod {
	get | put | post | delete | patch | trace
}

defineBucketOptions {
	(IfNotExistsClause | OverwriteClause)?
	value
	OnRootNsDbClause?
	(
		BackendClause |
		PermissionsBasicClause |
		readonly |
		CommentClause
	)*
}

// Alter statement

AlterStatement[since=2_0_0] {
	alter
	(
		( ( table | tb ) alterTableOptions ) |
		AlterSystem[since=4_0_0] { system alterSystemClause+ } |
		AlterNamespace[since=4_0_0] { ( namespace | ns ) compact } |
		AlterDatabase[since=4_0_0] { ( database | db ) value? alterSystemClause+ } |
		AlterDefinition[since=4_0_0] { alterKind IfExistsClause? alterTarget alterClause* } |
		AlterFunction[since=4_0_0] {
			functionKw IfExistsClause? customFunctionName
			( params ( "->" type )? Block )?
			alterClause*
		} |
		AlterParam[since=4_0_0] { param IfExistsClause? VariableName alterClause* } |
		AlterApi[since=4_0_0] {
			api IfExistsClause? value
			( ApiMethodClause | SecurityClause | DropClause | CommentClause )*
		} |
		AlterConfig[since=4_0_0] { config configTarget ( DropClause | CommentClause )* }
	)
}

alterTableOptions {
	(IfNotExistsClause | IfExistsClause)?
	value
	(
		DropClause |
		DropFlag[until=4_0_0] { drop ~dropTarget } |
		(schemafull | schemaful | schemaless) |
		TableTypeClause |
		PermissionsForClause |
		ChangefeedClause |
		InlineClause |
		MigrateClause |
		compact |
		CommentClause
	)*
}

alterSystemClause {
	compact |
	CompatibilityClause |
	QueryTimeoutClause { query_timeout value } |
	DropClause
}

alterKind {
	event | field | index | sequence | bucket | analyzer |
	user | access | extension | module | typeKeyword
}

alterTarget {
	value ( OnTableClause | OnRootNsDbClause )?
}

alterClause {
	WhenClause |
	ThenClause |
	AsyncClause |
	RetryClause |
	MaxdepthClause |
	TypeClause |
	readonly |
	inline |
	ValueClause |
	AssertClause |
	DefaultClause |
	ReferenceClause |
	MaterializeClause |
	MigrateClause |
	SqlTypeClause |
	PermissionsForClause |
	TokenizersClause |
	FiltersClause |
	FunctionClause |
	( ( password | passhash | passscram ) String ) |
	( roles commaSep<Ident> ) |
	DurationClause |
	AuthenticateClause |
	ContextClause |
	TimeoutClause |
	BackendClause |
	( revoke signatures ) |
	PrepareClause { prepare remove? } |
	( as type ) |
	TypeValueClause { add valueKeyword IfNotExistsClause? String ( ( before | after ) String )? } |
	TypeRenameClause { rename valueKeyword String to String } |
	DropClause |
	CommentClause
}

DropClause {
	drop ~dropTarget
	(
		comment | changefeed | inline ( edges | references )? | when | then | async |
		typeKeyword | flexible | readonly | valueKeyword | assert | default | reference |
		sql typeKeyword | functionKw | tokenizers | filters | authenticate | context |
		query_timeout | backend
	)
}

// Remove statement

RemoveStatement {
	remove
	(
		( ( namespace | ns ) expungeClause? IfExistsClause? value ) |
		( ( database | db ) expungeClause? IfExistsClause? value ) |
		( user IfExistsClause? value OnRootNsDbClause ) |
		TokenRemoval[until=4_0_0] { token IfExistsClause? value on ( namespace | database | scope ) } |
		( event IfExistsClause? value OnTableClause ) |
		( field IfExistsClause? value OnTableClause ) |
		( index IfExistsClause? value OnTableClause ) |
		( analyzer IfExistsClause? value ) |
		( functionKw IfExistsClause? customFunctionName ( "(" ")" )? ) |
		( param IfExistsClause? VariableName ) |
		ScopeRemoval[until=2_0_0] { scope IfExistsClause? value } |
		( ( table | tb ) expungeClause? IfExistsClause? value ) |
		( api IfExistsClause? value ) |
		( bucket IfExistsClause? value OnRootNsDbClause? ) |
		( access IfExistsClause? value OnRootNsDbClause ) |
		( sequence IfExistsClause? value ) |
		( ( extension | module ) IfExistsClause? ExtensionName ( "(" ")" )? ) |
		( config IfExistsClause? ( graphql | api | default ) ) |
		( typeKeyword IfExistsClause? Ident )
	)
}

expungeClause { binaryOperatorKeyword expunge }

// Clause groups

modifierClause[@isGroup=ModifierClause] {
	WithClause |
	WhereClause |
	SplitClause |
	GroupClause |
	OrderClause |
	LimitStartComboClause |
	FetchClause |
	TimeoutClause |
	ParallelClause |
	TempfilesClause |
	ExplainClause |
	VersionClause |
	ForUpdateClause |
	ReturnClause
}

dataClause[@isGroup=DataClause] {
	ContentClause |
	SetClause |
	MergeClause |
	PatchClause |
	ReplaceClause |
	UnsetClause
}

// Data statements

CreateStatement {
	create only?
	createTargets { commaSep<Ident | VariableName | FunctionCall | RecordId | MockRecord> }
	dataClause?
	createOptionals {
		ReturnClause?
		VersionClause?
		TimeoutClause?
		ParallelClause?
	}
}

SelectStatement {
	select
	Fields
	OmitClause?
	from
	only?
	(
		statement |
		(
			commaSep<value>
			modifierClause*
		)
	)
}

DeleteStatement {
	delete from? only?
	(
		statement |
		(
			commaSep<value>
			(
				WithClause |
				WhereClause |
				ReturnClause |
				TimeoutClause |
				ParallelClause |
				ExplainClause
			)*
		)
	)
}

InsertStatement {
	insert
	insertOptionals {
		(ignore | relation)*
		(into (Ident | VariableName))?
	}
	(
		// TODO this should be value, but cannot easily union with VALUES syntax
		Object |
		VariableName |
		BulkInsert[since=2_0_0] { ( "[" commaSep<Object> "]" ) } |
		(
			"(" commaSep<Ident> ")"
			values
			commaSep<(
				"(" commaSep<value> ")"
			)>
		)
	)
	(
		on duplicate key update
		commaSep<FieldAssignment>
	)?
	ReturnClause?
	VersionClause?
	TimeoutClause?
}

UpdateStatement {
	update only?
	(
		statement |
		(
			commaSep<value>
			WithClause?
			dataClause?
			updateOptionals {
				WhereClause?
				ReturnClause?
				TimeoutClause?
				ParallelClause?
				ExplainClause?
			}
		)
	)
}

UpsertStatement[since=2_0_0] {
	upsert only?
	(
		statement |
		(
			commaSep<value>
			WithClause?
			dataClause?
			upsertOptionals {
				WhereClause?
				ReturnClause?
				TimeoutClause?
				ParallelClause?
				ExplainClause?
			}
		)
	)
}

relateSubject { Array | Ident | FunctionCall | VariableName | RecordId | SubQuery }

RelateStatement {
	relate only?
	OrUpdateClause[since=4_0_0] { binaryOperatorKeyword update }?
	relateSubject ("->" | "<-") relateSubject ("->" | "<-") relateSubject
	unique?
	dataClause?
	relateOptionals {
		ReturnClause?
		TimeoutClause?
		ParallelClause?
	}
}

// Info statement

InfoForStatement {
	info for
	(
		root | kv |
		ns | namespace |
		db | database |
		InfoForScope[until=2_0_0] { ( sc | scope ) Ident } |
		( ( tb | table ) value ) |
		( user value OnRootNsDbClause? ) |
		( index value OnTableClause )
	)
	VersionClause?
	structure?
}

// Control statements

BreakStatement { break }
ContinueStatement { continue }
ForStatement { for VariableName in value Block }
ReturnStatement { return expression }
ThrowStatement[group="Statement Value"] { throw value !closure }

IfElseStatement[group="Statement Value"] {
	if
	(
		Legacy {
			value
			then
			value
			legacyElse
		} |
		Modern {
			value Block
			(
				!ifElse else if
				value Block
			)*
			(
				!ifElse else Block
			)?
		}
	)
}

legacyElse {
	end |
	!ifElse else if value then value legacyElse |
	!ifElse else value end
}

// Live statements

KillStatement { kill ( String | prefixedString | VariableName ) }
LiveSelectStatement {
	live select
	(
		diff |
		valueKeyword Predicate |
		commaSep<inclusivePredicate>
	)
	from commaSep<value>
	WhereClause?
	FetchClause?
}

// Let statement

LetStatement {
	let
	paramDefinition
	"="
	(value | subqueryStatement)
}

// Show statement

ShowStatement {
	show changes for
	( ( table | tb ) Ident | database )
	( since ( Number | String | prefixedString ) )?
	( limit Number )?
}

// Sleep statement

SleepStatement {
	sleep Duration
}

// Use statement

useNs { ( ns | namespace ) ( Ident | VariableName ) }
useDb { ( db | database ) ( Ident | VariableName ) }

UseStatement {
	use
	( useNs | useDb | ( useNs useDb ) | default )
}

// Option statement

OptionStatement {
	option
	Ident
	( "=" ( true | false ) )?
}

// Rebuild statement

RebuildStatement[since=1_5_0] {
	rebuild index
	IfExistsClause?
	Ident
	OnTableClause
	concurrently?
}

// Values

computedValue[@isGroup=Value] {
	String |
	prefixedString |
	Number |
	true |
	false |
	null |
	none |
	Array |
	Set |
	RecordId |
	Object |
	Duration |
	Point { "(" Number "," Number ")" }
}

baseValue[@isGroup=Value] {
	computedValue |
	FormatString |
	Regex |
	VariableName |
	Ident[@dynamicPrecedence=-1] { rawident | tickIdent | bracketIdent } |
	FunctionJs |
	FunctionCall |
	Constant[since=2_0_0] { FunctionName } |
	SubQuery |
	Block |
	TypeCast
}

value[@isGroup=Value] {
	baseValue |
	IfElseStatement |
	ThrowStatement |
	Closure |
	MockRecord |
	UnaryExpression |
	BinaryExpression |
	Range |
	Path
}

Any { "?" }
AnyStar[@name=Any] { "*" }
At[since=2_1_0] { "@" }
Optional[since=2_0_0,until=4_0_0] { "?" }

// Unary and binary expressions

UnaryExpression {
	"!" !prefix value
}

BinaryExpression {
	value !binary Operator value
}

Range[since=2_0_0] {
	rangeOpOpenBoth |
	value !range rangeOpOpenRight |
	rangeOpOpenLeft !range value |
	value !range rangeOp !range value
}

Idiom {
	Ident idiomPart*
}

idiomPart {
	"." ( Ident | AnyStar ) |
	"[" ( AnyStar | Number | "$" ) "]"
}

Path {
	baseValue pathElement+ |
	At ( dotPart pathElement* | pathElement+ ) |
	Lookup pathElement*
}

pathElement {
	Lookup |
	Subscript {
		Optional?
		"."
		dotPart
	} |
	OptionalPart[since=4_0_0] { "." "?" } |
	LastIndex[since=4_0_0] { !filter "[" "$" "]" } |
	AllElements { !filter "[" AnyStar "]" } |
	Flatten[since=4_0_0] { flattenOp } |
	Filter { !filter "[" (WhereClause | WhereClause { "?" value } | expression) "]" }
}

dotPart {
	At |
	Ident |
	IdiomFunction |
	AnyStar |
	Destructure |
	Recurse
}

Lookup {
	("<-" | "->" | "<->" | "<~")
	(Ident | RecordId | Any | LookupSelection)
}

LookupSelection {
	"("
	GraphFieldSelection[since=2_2_0] {
		select
		Fields
		from
		only?
	}?
	commaSep<GraphPredicate>
	(
		WhereClause |
		GraphSplitClause[since=2_2_0] { SplitClause } |
		GraphGroupClause[since=2_2_0] { GroupClause } |
		GraphOrderClause[since=2_2_0] { OrderClause } |
		GraphLimitStartComboClause[since=2_2_0] { LimitStartComboClause } |
		as Ident
	)*
	")"
}

GraphPredicate {
	(value | Any)
	LookupField[since=4_0_0] { field Ident }?
}

Destructure[since=2_0_0] {
	"{" commaSepTrailing<((Ident ":" value) | (( Ident | Lookup ) pathElement* ) | flattenOp)> "}"
}

IdiomFunction[since=2_0_0] { 
	FunctionName { rawident !method } ArgumentList 
}

// Recursion

Recurse[since=2_1_0] {
	"{" RecurseRange RecurseOptions "}"
	( "(" pathElement+ ")" )?
}

RecurseRange {
	Number |
	rangeOpOpenBoth |
	Number rangeOpOpenRight |
	rangeOpOpenLeft Number |
	Number rangeOp Number
}

RecurseOptions[since=2_2_0] {
	("+" recurseOptionName ("=" baseValue)?)*
}

recurseOptionName[@name=FunctionName] {
	rawident
}

// Fields

Fields {
	valueKeyword Predicate |
	commaSep<inclusivePredicate>
}

// Objects

ObjectKey {
	KeyName { rawident } |
	String
}

ObjectProperty {
	ObjectKey ":" value
}

ObjectContent {
	commaSepTrailing<ObjectProperty>
}

Object {
	objectOpen ObjectContent? "}"
}

// Arrays

Array {
	"[" commaSepTrailing<value>? "]"
}

// Sets

Set { 
	"{" (
		"," |
		value "," |
		value "," value ("," value)*
	) "}"
}

// Record Ids

RecordTbIdent {
	rawident |
	tickIdent |
	bracketIdent
}

// Ideally we match "Number" here, but I cannot for the life of me get it to
// fall back to numberident after. This will suffice for now.
RecordIdIdent {
	numberident |
	tickIdent |
	bracketIdent
}

recordIdValue {
	RecordIdIdent |
	Array |
	Object |
	RecordIdString { prefixedString }
}

RecordIdRange {
	rangeOpOpenBoth |
	recordIdValue !range rangeOpOpenRight |
	rangeOpOpenLeft !range recordIdValue |
	recordIdValue !range rangeOp !range recordIdValue
}

RecordId {
	RecordTbIdent
	":"
	( recordIdValue | RecordIdRange )
}

// Durations

Duration {
	DurationPart+
}

// JS Functions

FunctionJs {
	FunctionName { function }
	ArgumentList
	JavaScriptBlock
}

@skip {} {
	JavaScriptBlock {
		"{" JavaScriptContent { javaScriptElement* } "}"
	}
	javaScriptElement {
		javaScriptContent | javaScriptBraceOpen javaScriptElement* javaScriptBraceClose
	}
	BlockComment {
		"/*" (blockCommentContent | blockCommentNewline)* blockCommentEnd
	}
	FormatString[until=4_0_0] {
		'$"' (formatStringContentDouble | Interpolation)* '"' |
		"$'" (formatStringContentSingle | Interpolation)* "'"
	}
}

Interpolation {
	"{" expression "}"
}

// Function invocation

FunctionCall {
	(
		(FunctionName | customFunctionName | rand | count)
		( Version ( "::" ( FunctionName | customFunctionName | extFunctionName ) )? )?
		ArgumentList
	) |
	RecordId ArgumentList |
	VariableName ArgumentList |
	SubQuery ArgumentList
}

extFunctionName[@name=FunctionName] { rawident }

ArgumentList { "(" (commaSepTrailing<value>? | subqueryStatement) ")" }

// Assignment

FieldAssignment {
	Ident idiomPart*
	assignmentOperator
	value
}

// Clauses

MergeClause {
	merge value
}

PatchClause {
	patch value
}

TableTypeClause[since=1_4_0] {
	typeKeyword
	(
		any |
		normal |
		(
			relation
			( ( in | from ) piped<Ident> )?
			( ( out | to ) piped<Ident> )?
			EnforcedClause[since=2_0_0] { enforced? }
			LightweightClause[since=4_0_0] { lightweight }?
		)
	)
}

TableViewClause {
	as
	( tableView | "(" tableView ")" )
}

tableView {
	select
	( valueKeyword Predicate | commaSep<inclusivePredicate> )
	from
	commaSep<value>
	WhereClause?
	GroupClause?
}

ChangefeedClause {
	changefeed
	Duration
	IncludeOriginal[since=4_0_0] { include original }?
}

InlineClause[since=4_0_0] {
	inline
	( edges | references )
	Number
}

MaterializeClause[since=4_0_0] {
	materialize into
	Idiom
	WhereClause?
}

MigrateClause[since=4_0_0] {
	migrate existing rows as Ident
	(
		using value ( fallback value )? |
		remove undeclared fields
	)
}

SqlTypeClause[since=4_0_0] {
	sql typeKeyword
	Ident
	String
}

GraphqlClause[since=4_0_0] {
	( graphql_alias | graphql_deprecated )
	String
}

ContextClause[since=4_0_0] {
	context
	value
}

SessionClause {
	session
	Duration
}

SignupClause {
	signup
	( SubQuery | Block )
}

SigninClause {
	signin
	( SubQuery | Block )
}

AuthenticateClause {
	authenticate
	( SubQuery | Block )
}

JwtClause {
	( algorithm jwtAlgorithm key value | url value )
	JwtAudience[since=4_0_0] { audience commaSep<value> }?
	JwtIssuer { ~jwtWith with issuer ( algorithm jwtAlgorithm | key value )+ }?
	~jwtWith
}

jwtAlgorithm { TokenType | Ident }

OnTableClause {
	on ( table | tb )? value
}

OnRootNsDbClause {
	on ( root | kv | namespace | ns | database | db )
}

AccessTypeClause {
	typeKeyword (
		( jwt JwtClause ) |
		( record (SignupClause | SigninClause)* ( ~jwtWith with ( jwt JwtClause | refresh ) )* ) |
		BearerAccess[since=4_0_0] { bearer for ( user | record ) ( with jwt JwtClause )? }
	)
}

FieldsColumnsClause {
	( fields | columns ) commaSep<(Idiom | FunctionCall)>
}

IndexClause {
	UniqueClause |
	SearchAnalyzerClause |
	MtreeClause |
	HnswClause |
	FulltextClause |
	DiskannClause |
	CountClause |
	SpatialClause
}

UniqueClause {
	unique
	NullsNotDistinct[since=4_0_0] { nulls not distinct }?
}

CountClause[since=4_0_0] {
	count
	WhereClause?
}

SpatialClause[since=4_0_0] {
	spatial
}

FulltextClause[since=4_0_0] {
	fulltext
	(
		( analyzer Ident ) |
		Bm25Clause |
		highlights
	)*
}

DiskannClause[since=4_0_0] {
	diskann
	IndexDimensionClause
	(
		HnswDistClause |
		IndexVectorTypeClause |
		hashed_vector |
		( ( degree | l_build | alpha ) Number )
	)*
}

SearchAnalyzerClause[until=4_0_0] {
	search analyzer
	Ident
	(
		Bm25Clause |
		DocIdsOrderClause |
		DocLenghtsOrderClause |
		PostingsOrderClause |
		TermsOrderClause |
		DocIdsCacheClause |
		DocLenghtsCacheClause |
		PostingsCacheClause |
		TermsCacheClause |
		highlights
	)*
}

Bm25Clause { bm25 ( "(" Number "," Number ")")? }
DocIdsCacheClause { doc_ids_cache Number }
DocIdsOrderClause { doc_ids_order Number }
DocLenghtsCacheClause { doc_lengths_cache Number }
DocLenghtsOrderClause { doc_lengths_order Number }
PostingsCacheClause { postings_cache Number }
PostingsOrderClause { postings_order Number }
TermsCacheClause { terms_cache Number }
TermsOrderClause { terms_order Number }

MtreeClause[since=1_3_0,until=4_0_0] {
	mtree
	IndexDimensionClause
	(
	MtreeDistClause |
	IndexTypeClause |
	IndexCapacityClause |
	DocIdsOrderClause |
	DocIdsCacheClause |
	MtreeCacheClause
	)*
}

MtreeCacheClause { mtree_cache Number }
MtreeDistClause { dist ( Distance ) }

HnswClause[since=1_5_0] {
hnsw
IndexDimensionClause
	(
	HnswDistClause |
	IndexTypeClause |
	IndexVectorTypeClause |
	IndexCapacityClause |
	IndexLmClause |
	IndexM0Clause |
	IndexMClause |
	IndexEfcClause |
	IndexExtendCandidatesClause |
	IndexKeepPrunedConnectionsClause |
	hashed_vector
	)*
}

HnswDistClause { ( dist | distance ) ( Distance | ( minkowski Number )) }

IndexVectorTypeClause { typeKeyword IndexTypeClause }

IndexDimensionClause { dimension Number }
IndexCapacityClause { capacity Number }
IndexLmClause { lm Number }
IndexM0Clause { m0 Number }
IndexMClause { m Number }
IndexEfcClause { efc Number }
IndexExtendCandidatesClause { extend_candidates }
IndexKeepPrunedConnectionsClause { keep_pruned_connections }

ContentClause {
	content value
}

ReplaceClause {
	replace value
}

SetClause {
	set commaSep<FieldAssignment>
}

OmitClause {
	omit commaSep<inclusivePredicate>
}

UnsetClause {
	unset commaSep<Idiom>
}

IfNotExistsClause[since=1_3_0] {
	if not exists
}

IfExistsClause[since=1_3_0] {
	if exists
}

OverwriteClause[since=2_0_0] {
	overwrite
}

ReturnClause {
	return
	( before | after | diff | Fields )
}

TimeoutClause {
	timeout
	clauseValue
}

ParallelClause[until=4_0_0] {
	parallel
}

ForUpdateClause[since=4_0_0] {
	for update
}

TempfilesClause[since=2_0_0] {
	tempfiles
}

FetchClause {
	fetch
	commaSep<Idiom>
}

StartClause {
	start
	at?
	clauseValue
}

LimitClause {
	limit
	by?
	clauseValue
}

LimitStartComboClause {
	StartClause (!clause LimitClause)? |
	LimitClause (!clause StartClause)?
}

GroupClause {
	group
	(
	    by? commaSep<Idiom> |
	    all
	)
}

OrderClause {
	order
	by?
	(commaSep<Order> | FunctionCall)
}

SplitClause {
	split
	on?
	commaSep<Idiom>
}

WhereClause {
	where
	value
}

WithClause {
	with
	(
		noindex |
		( no index ) |
		index commaSep<Ident>
	)
}

ExplainClause {
	explain
	full?
}

VersionClause[since=2_0_0] {
	version
	clauseValue
}

TokenizersClause { tokenizers commaSep<analyzerTokenizerItem> }

analyzerTokenizerItem { AnalyzerTokenizer ( "(" Ident ")" )? }

FiltersClause {
	filters
	commaSep<AnalyzerFilters>
}

FunctionClause {
	functionKw
	( customFunctionName | FunctionName )
}

TypeClause {
	( flexible typeKeyword type ) |
	( typeKeyword type !flexibleAfter flexible ) |
	( typeKeyword type )
}

ReadonlyClause[since=1_2_0] {
	readonly
}

DefaultClause {
	default
	DefaultAlways[since=2_2_0] { always? }
	value
}

ValueClause {
	valueKeyword
	value
}

AssertClause {
	assert
	value
}

ReferenceClause {
	reference
	(on delete (reject | cascade | ignore | unset | then value))?
}

ComputedClause {
	computed
	value
}

PermissionGroup {
	for
	commaSep<select | create | update | delete>
	( WhereClause | none | full )
}

PermissionsForClause {
	permissions
	(
		none | full | WhereClause |
		PermissionGroup ( ","? PermissionGroup )*
	)
}

PermissionsBasicClause {
	permissions
	(none | full | WhereClause)
}

MiddlewareClause {
	middleware
	commaSep<FunctionCall>
}

CommentClause {
	comment
	( String | VariableName )
}

DurationValue {
	for ( token | session | grant ) ( Duration | none )
}

DurationClause[since=2_0_0] {
	duration DurationValue ( ","? DurationValue )*
}

TokenTypeClause {
	typeKeyword
	TokenType
}

BackendClause {
	backend
	value
}

// Support

clauseValue { Number | Duration | VariableName | prefixedString | FunctionCall | SubQuery | none }

AnalyzerFilters {
	Filter ("(" (Number "," Number | Ident | String) ")")?
}

Order {
	Idiom
	collate?
	numeric?
	( asc | desc | ascending | descending )?
}

Predicate {
	value |
	value as Ident
}

inclusivePredicate {
	AnyStar | Predicate
}

// Types

LiteralType[since=2_0_0] {
	String |
	prefixedString |
	Number |
	Duration |
	true |
	false |
	ArrayType { "[" commaSepTrailing<(ObjectTypeProperty | type)>? "]" } |
	ObjectType { objectOpen ObjectTypeContent? "}" }
}

singleType {
	TypeName { (rawident | tickIdent | bracketIdent) ~closureArrow } |
	ParameterizedType { singleType "<" commaSep<type> ">" } |
	LiteralType
}

type {
	singleType |
	UnionType { type (!union "|" type)+ }
}

safeType {
	singleType | "<" type ">"
}

ObjectTypeContent {
	commaSepTrailing<ObjectTypeProperty>
}

ObjectTypeProperty {
	ObjectKey ":" type
}

TypeCast {
	"<" type ">" baseValue
}

Ident {
	(rawident | tickIdent) ~closureArrow
}

Number { ("-" | "+")? (Int | Float | Decimal) }

Operator {
	binaryOperator |
	"-" | "=" | ">" | "<" |
	binaryOperatorKeyword |
	is | ( is not ) |
	in | ( not in ) |

	( "@" ( Number ( "," binaryOperatorKeyword )? | binaryOperatorKeyword ) "@" ) |
	(
		"<|"
		Number
		( "," ( Number | Distance | ( minkowski Number ) ) )
		"|>"
	)
}

@local tokens {
	blockCommentEnd { "*/" }
	blockCommentNewline { "\n" }
	@else blockCommentContent
}

@external tokens objectToken from "./tokens" {
	objectOpen[@name=BraceOpen]
}

@external tokens versionToken from "./tokens" {
	Version
}

@external tokens rangeOperator from "./tokens" {
	rangeOp[@name=RangeOp],
	rangeOpOpenBoth[@name=RangeOp],
	rangeOpOpenLeft[@name=RangeOp],
	rangeOpOpenRight[@name=RangeOp]
}

@tokens {
	// Characters
	"{"[@name=BraceOpen]
	"}"[@name=BraceClose]
	"[" "]"
	"<" ">"
	":"[@name=Colon]
	"->"[@name=LookupRight]
	"<-"[@name=LookupLeft]
	"<~"[@name=LookupLeft]
	"<->"[@name=LookupBoth]
	"|"[@name=Pipe]
	"!"[@name=Operator]
	"~"[until=2_4_0]
	"!~"[until=2_4_0]
	"*~"[until=2_4_0]

	// Helpers
	whitespace { $[ \n\r\t] }

	// Comments
	Comment { CommentHash | CommentDash | CommentSlash }
	CommentHash { "#" ![\n]* }
	CommentDash { "--" ![\n]* }
	CommentSlash { "//" ![\n]* }
	CommentResult[@name=Comment,closedBy=CommentResultClose] { "-------- Query" ![\n]* }

	// Numbers
	digitSeq { @digit+ ("_" @digit+)* }
	intSuffix { $[iu] ("8" | "16" | "32" | "64") }
	floatSuffix { "f" ("16" | "32" | "64")? }
	Int { digitSeq intSuffix? }
	frac { '.' digitSeq }
	exp { $[eE] $[+\-]? digitSeq }
	Float { (digitSeq floatSuffix) | (digitSeq (frac exp? | exp) floatSuffix?) | "Infinity" | "NaN" }
	Decimal { digitSeq frac? exp? ("dec" | "bigdec") }

	String { "'" (!['\\] | "\\" _)* "'" | '"' (!["\\] | "\\" _)* '"' }
	prefixedString[@name=String] { ($[rudbfs] | "pd" | "pt" | "ts" | "ivl") String }

	formatStringContentDouble { ("\\" _ | !["{\\])+ }
	formatStringContentSingle { ("\\" _ | !['{\\])+ }

	// Language
	VariableName { "$" (rawident | tickIdent | bracketIdent) }
	tickIdent {
		"`" ![`]+ '`'
	}
	bracketIdent {
		"⟨" ![⟩]+ "⟩"
	}
	rawident { (@asciiLetter | "_") (@asciiLetter | @digit | "_")* }
	numberident {
		rawident |
		@digit (@asciiLetter | @digit | "_")*
	}

	functionNameSegment { (@asciiLetter | "_") (@asciiLetter | "_" | @digit)* }
	// A trailing "::" belongs to the name so that "::" never needs to be
	// lexed after a function name, where it would conflict with ":".
	FunctionName {
		functionNameSegment ("::" functionNameSegment)+ "::"?
	}
	customFunctionName[@name=FunctionName] {
		"fn" ("::" functionNameSegment)* "::"?
	}

	Regex { "/" (![/\\\n[] | "\\" ![\n] | "[" (![\n\\\]] | "\\" ![\n])* "]")+ ("/" $[dgimsuvy]*)? }

	durationUnit { "ns" | "us" | "µs" | "ms" | "s" | "m" | "h" | "d" | "w" | "y"}
	DurationPart { digitSeq " "* durationUnit }

	@precedence { CommentResult Comment Int "-" }
	@precedence { Comment binaryOperator }
	@precedence { Decimal Float Int rawident }
	@precedence { DurationPart Int rawident }
	@precedence { prefixedString numberident rawident }
	@precedence { customFunctionName FunctionName rawident }
	@precedence { "f'" 'f"' rawident }
	@precedence { "/*" Regex }
	@precedence { Float FunctionName }
	@precedence { VariableName "$" }

	javaScriptContent { "\n" | ![{}\n'"]+ "\n"? | String }
	javaScriptBraceOpen { "{" }
	javaScriptBraceClose { "}" }

	binaryOperator {
		"&&" | "||" | "??" | "?:" | "!=" | "==" | "?=" | "*=" | "~" | "!~" | "*~" |
		"<=" | ">=" | "+" | "+=" | "-=" | "*" | "×" | "∙" | "/"  | "÷" | "%" | "**" |
		$[∋∌⊇⊃⊅∈∉⊆⊂⊄] | "@@"
	}

	assignmentOperator[@name=Operator] {
		"="  |
		"+=" |
		"-=" |
		"+?="
	}

	flattenOp[@name=Operator] { "..." | "…" }

	"::" "$"
}

commaSep<content> {
	content ("," content)*
}

commaSepTrailing<content> {
	content ("," content)* ","?
}

piped<content> {
	content ("|" content)*
}

@skip { whitespace | Comment | BlockComment }
@detectDelim

@external propSource surqlHighlighting from "./highlight"
@external prop since from "./version"
@external prop until from "./version"

@external extend { rawident } tokens from "./tokens" {
	access					[@name=Keyword],
	add						[@name=Keyword],
	algorithm				[@name=Keyword],
	all						[@name=Keyword],
	alpha					[@name=Keyword],
	alter					[@name=Keyword],
